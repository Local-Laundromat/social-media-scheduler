# ===================================
# Supabase Configuration for Quu
# ===================================

# Your Supabase Project
SUPABASE_URL=https://nnvxkooiwyrlqbxhqxac.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_KEY=your_supabase_service_role_key_here

# Database Connection
# Go to: https://supabase.com/dashboard/project/nnvxkooiwyrlqbxhqxac/settings/database
# Copy the "URI" connection string and replace [YOUR-PASSWORD] with your database password
SUPABASE_DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.nnvxkooiwyrlqbxhqxac.supabase.co:5432/postgres

# Enable PostgreSQL (set to 'true' to use Supabase, 'false' to use local SQLite)
USE_POSTGRES=true

# ===================================
# Server Configuration
# ===================================
PORT=3000
NODE_ENV=development
AUTO_START_SCHEDULER=false
CRON_SCHEDULE=0 * * * *

# ===================================
# Authentication
# ===================================
JWT_SECRET=your-super-secret-jwt-key-change-in-production-please
SESSION_SECRET=your-session-secret-here

# ===================================
# AI Caption Generation (Optional)
# ===================================
OPENAI_API_KEY=your_openai_api_key_here

# ===================================
# Facebook OAuth
# ===================================
# Create app at: https://developers.facebook.com
FACEBOOK_APP_ID=your_facebook_app_id_here
FACEBOOK_APP_SECRET=your_facebook_app_secret_here
FACEBOOK_REDIRECT_URI=http://localhost:3000/auth/facebook/callback

# ===================================
# Instagram OAuth
# ===================================
INSTAGRAM_APP_ID=your_instagram_app_id_here
INSTAGRAM_APP_SECRET=your_instagram_app_secret_here
INSTAGRAM_REDIRECT_URI=http://localhost:3000/auth/instagram/callback

# ===================================
# TikTok OAuth
# ===================================
# Create app at: https://developers.tiktok.com
TIKTOK_CLIENT_KEY=your_tiktok_client_key_here
TIKTOK_CLIENT_SECRET=your_tiktok_client_secret_here
TIKTOK_REDIRECT_URI=http://localhost:3000/auth/tiktok/callback

# ===================================
# Public URLs (Auto-configured by Supabase Storage)
# ===================================
# Files are automatically hosted on Supabase Storage
# Public URL format: https://nnvxkooiwyrlqbxhqxac.supabase.co/storage/v1/object/public/quu-media/{filename}
PUBLIC_FILE_URL=https://nnvxkooiwyrlqbxhqxac.supabase.co/storage/v1/object/public/quu-media

# ===================================
# Rate limits (Express, per IP — optional overrides)
# ===================================
# GENERAL_RATE_LIMIT_MAX=100     # requests per 15 minutes (default 100)
# AUTH_RATE_LIMIT_MAX=5          # failed login/signup tries per 15 min (successful logins don't count)
# AI_RATE_LIMIT_MAX=50           # AI API calls per hour
# DISABLE_RATE_LIMIT=true       # LOCAL ONLY — turns off these limiters entirely (never use in production)

# JWT verify call to Supabase Auth (middleware). Prevents hung /api/me and /api/clients if Auth never responds.
# SUPABASE_AUTH_TIMEOUT_MS=12000

# ===================================
# Stripe subscriptions (Checkout + Customer Portal + webhooks)
# See STRIPE_BILLING.md for workflow and API table.
# ===================================
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Recurring price IDs (Dashboard → Products → Price → API ID)
STRIPE_PRICE_STARTER=price_...
STRIPE_PRICE_GROWTH=price_...
STRIPE_PRICE_PRO=price_...
STRIPE_PRICE_AGENCY=price_...

# Optional: yearly recurring price IDs → homepage "annual" column matches Stripe totals exactly.
# (Checkout still uses monthly STRIPE_PRICE_* unless you extend billing routes for annual.)
# STRIPE_PRICE_STARTER_ANNUAL=price_...
# STRIPE_PRICE_GROWTH_ANNUAL=price_...
# STRIPE_PRICE_PRO_ANNUAL=price_...
# STRIPE_PRICE_AGENCY_ANNUAL=price_...

# Homepage /api/public/pricing cache (seconds)
# PUBLIC_PRICING_CACHE_SECONDS=60

# If no annual Stripe price IDs, estimated effective monthly × 12 (~default 20% off monthly display)
# PUBLIC_PRICING_ANNUAL_DISCOUNT_PERCENT=20

# Public site URL (success/cancel + portal return). Railway: https://your-app.up.railway.app
APP_PUBLIC_URL=http://localhost:3000

# Optional: override pinned API version (default matches installed stripe npm package)
# STRIPE_API_VERSION=2026-04-22.dahlia

# Optional explicit redirect URLs (otherwise derived from APP_PUBLIC_URL)
# STRIPE_CHECKOUT_SUCCESS_URL=https://example.com/dashboard?billing=success
# STRIPE_CHECKOUT_CANCEL_URL=https://example.com/dashboard?billing=cancel
# STRIPE_PORTAL_RETURN_URL=https://example.com/dashboard?billing=portal

# ===================================
# INSTRUCTIONS
# ===================================
# 1. Get your Supabase credentials from:
#    https://supabase.com/dashboard/project/nnvxkooiwyrlqbxhqxac/settings/api
#
# 2. Get your database password from:
#    https://supabase.com/dashboard/project/nnvxkooiwyrlqbxhqxac/settings/database
#
# 3. Copy this file to .env and fill in your actual values
#
# 4. Never commit .env to git!
